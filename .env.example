# ---------------------------------------------------------------------------
# AnyTimeRental — environment variables
# Copy to .env.local and fill in. NEVER commit .env.local.
# ---------------------------------------------------------------------------

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...            # "anon" / "publishable" key (safe for browser)
SUPABASE_SERVICE_ROLE_KEY=eyJ...                # "service_role" key — server only, full access

# Supabase Postgres connection — Project Settings > Database > Connection string
# Use the "Session pooler" URI (port 5432). Needed only for `npm run db:migrate` and `npm run seed`.
# Password-encode special characters (@ -> %40).
SUPABASE_DB_URL=postgresql://postgres.YOUR_PROJECT_REF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Stripe — Dashboard > Developers > API keys (use test keys for local dev)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook`, or Dashboard > Webhooks
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend — https://resend.com/api-keys . From/reply address must be a verified domain
# (or use onboarding@resend.dev for testing).
RESEND_API_KEY=re_...
EMAIL_FROM="AnyTimeRental <onboarding@resend.dev>"

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ADMIN_EMAIL=owner@example.com                   # this user is granted the admin role on sign-up / seed

# Cron secret — protects /api/cron/* ; set the same value in Vercel Cron settings
CRON_SECRET=generate-a-long-random-string
